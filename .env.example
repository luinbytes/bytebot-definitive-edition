# Discord Bot Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - Bot Authentication
# ============================================
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# ============================================
# REQUIRED - Development Guild (for testing)
# ============================================
GUILD_ID=your_test_guild_id_here

# ============================================
# OPTIONAL - Database
# ============================================
# Path to SQLite database file (defaults to sqlite.db in project root)
# DATABASE_URL=sqlite.db

# ============================================
# OPTIONAL - Self-hosted Music
# ============================================
# Directory containing music.json and operator-owned audio files.
# MUSIC_LIBRARY_PATH=/srv/bytebot/music
# Override only when FFmpeg is not available as `ffmpeg` on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Override only when FFprobe is not available as `ffprobe` on PATH.
# FFPROBE_PATH=/usr/bin/ffprobe

# ============================================
# OPTIONAL - Command Deployment Control
# ============================================
# Controls automatic command deployment behavior
# Values: none | guild | global
# - none: Deploy once on first run, then manual only (recommended for production)
# - guild: Auto-deploy to GUILD_ID on changes (instant, good for testing)
# - global: Auto-deploy globally on changes (1hr propagation, production)
# - unset: Defaults to 'guild' if GUILD_ID is set
# AUTO_DEPLOY=none
# ============================================
# OPTIONAL - External Lookups
# ============================================
# HTTPS screenshot provider template. The literal {url} is replaced with an encoded public target URL.
# Use an isolated provider that independently blocks private/link-local targets,
# redirects, and DNS rebinding; ByteBot cannot enforce an opaque provider's browser network policy.
# SCREENSHOT_API_URL=https://provider.example/screenshot?url={url}

# LibreTranslate-compatible HTTPS endpoint and optional API key.
# LIBRETRANSLATE_URL=https://translate.example/
# LIBRETRANSLATE_API_KEY=

# Local OCR and synthetic speech executables. Issue #63 packages and verifies
# exact production versions; no helper process runs while these commands are idle.
# TESSERACT_PATH=/usr/bin/tesseract
# ESPEAK_NG_PATH=/usr/bin/espeak-ng

# Heartbeat file used by the production container health check. The default is
# writable in the packaged image; change both the bot and health check together.
# BYTEBOT_HEALTH_FILE=/tmp/bytebot-health
