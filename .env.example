# Discord Bot Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - Bot Authentication
# ============================================
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# ============================================
# REQUIRED - Development Guild (for testing)
# ============================================
GUILD_ID=your_test_guild_id_here

# ============================================
# OPTIONAL - Database
# ============================================
# Path to SQLite database file (defaults to sqlite.db in project root)
# DATABASE_URL=sqlite.db

# ============================================
# OPTIONAL - Command Deployment Control
# ============================================
# Controls automatic command deployment behavior
# Values: none | guild | global
# - none: Deploy once on first run, then manual only (recommended for production)
# - guild: Auto-deploy to GUILD_ID on changes (instant, good for testing)
# - global: Auto-deploy globally on changes (1hr propagation, production)
# - unset: Defaults to 'guild' if GUILD_ID is set
# AUTO_DEPLOY=none

# ============================================
# OPTIONAL - Last.fm
# ============================================
# Read-only Last.fm commands require an API key.
# LASTFM_API_KEY=your_lastfm_api_key
# OAuth additionally requires all values below. Put the callback behind HTTPS
# and reverse-proxy it to the loopback port.
# LASTFM_SHARED_SECRET=your_lastfm_shared_secret
# LASTFM_CALLBACK_URL=https://bot.example/lastfm/callback
# LASTFM_OAUTH_PORT=8787
# LASTFM_SESSION_ENCRYPTION_KEY=generate_a_long_random_secret
