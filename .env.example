# Discord Bot Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - Bot Authentication
# ============================================
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# ============================================
# REQUIRED - Development Guild (for testing)
# ============================================
GUILD_ID=your_test_guild_id_here

# ============================================
# OPTIONAL - Database
# ============================================
# Path to SQLite database file (defaults to sqlite.db in project root)
# DATABASE_URL=sqlite.db

# ============================================
# OPTIONAL - Self-hosted Music
# ============================================
# Directory containing music.json and operator-owned audio files.
# MUSIC_LIBRARY_PATH=/srv/bytebot/music
# Override only when FFmpeg is not available as `ffmpeg` on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Override only when FFprobe is not available as `ffprobe` on PATH.
# FFPROBE_PATH=/usr/bin/ffprobe

# ============================================
# OPTIONAL - Command Deployment Control
# ============================================
# Controls automatic command deployment behavior
# Values: none | guild | global
# - none: Deploy once on first run, then manual only (recommended for production)
# - guild: Auto-deploy to GUILD_ID on changes (instant, good for testing)
# - global: Auto-deploy globally on changes (1hr propagation, production)
# - unset: Defaults to 'guild' if GUILD_ID is set
# AUTO_DEPLOY=none
